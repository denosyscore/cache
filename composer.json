{
  "name": "denosyscore/cache",
  "description": "Cache abstractions and file cache implementation",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Cache\\": "src/Cache/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.18.x-dev"
    }
  }
}
